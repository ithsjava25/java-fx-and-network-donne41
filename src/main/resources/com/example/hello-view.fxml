<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="root" prefHeight="391.0" prefWidth="388.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HelloController">
    <top>
        <HBox fx:id="topHbox">
            <Circle fx:id="connectionStatus" />
            <Text fx:id="currentTopic" />
        <Region fx:id="spacerTopBox" HBox.hgrow="SOMETIMES" />
            <ImageView fx:id="settingsImage" />
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="messageArea" fitToHeight="true" fitToWidth="true">
            <VBox fx:id="messageList" alignment="TOP_CENTER" spacing="1">
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox>
            <Button fx:id="sendImage" onAction="#sendImage" />
            <TextField fx:id="outgoingMessage" onAction="#enterButtonSend" onDragDropped="#sendImage" text="Send a message" HBox.hgrow="SOMETIMES" />
            <Button fx:id="sendButton" onAction="#enterButtonSend" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
