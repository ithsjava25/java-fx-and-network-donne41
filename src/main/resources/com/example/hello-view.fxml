<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox stylesheets="@../../css/style.css" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.HelloController">
    <Label fx:id="messageLabel" text="${controller.model.points}" />
    <HBox alignment="CENTER" spacing="20">
        <ImageView image="${controller.model.left}" onMouseClicked="#image1"/>
        <ImageView image="${controller.model.middle}" onMouseClicked="#image2"/>
        <ImageView image="${controller.model.right}" onMouseClicked="#image3"/>

    </HBox>

</VBox>
