<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HelloController">
    <children>
      <BorderPane prefHeight="364.0" prefWidth="357.0">
         <center>
              <VBox fx:id="smallVboxContent" alignment="center" BorderPane.alignment="CENTER">
                  <Label fx:id="messageLabel" text="Hello, JavaFX!" textFill="#6fa32a">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
                  <Label fx:id="dateAndTimeLable" text="" textAlignment="CENTER" />
                  <Button fx:id="upDateButton" onAction="#updateButtonAction" text="Update" />
                  <Label fx:id="secoundDateTime" text="${controller.model.dateAndTimeLable}" />
                  <CheckBox fx:id="toggleTime" text="leave more" />
                  <TextField fx:id="fieldOfText" disable="${!toggleTime.selected}" />
              </VBox>
         </center>
      </BorderPane>
    </children>
</StackPane>
